<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>UniTyped.Generator</RootNamespace>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <OutputPath>bin\Debug</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <OutputPath>bin\Release</OutputPath>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Irony" />
      <PackageReference Include="Irony.Interpreter" />
      <!-- Roslyn is provided by the host (Unity / dotnet) at runtime. Exclude runtime DLLs so we do not ship a second copy. -->
      <PackageReference Include="Microsoft.CodeAnalysis" ExcludeAssets="runtime" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" ExcludeAssets="runtime" />
      <PackageReference Include="Newtonsoft.Json" />
      <PackageReference Include="VYaml" />
    </ItemGroup>

</Project>
